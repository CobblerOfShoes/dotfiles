### Bash Prompt Configuration ### {{{

# Change default command line prompt #
#export PS1='\! [\u@\h \W]$ '
# With colors:
GREEN="$(tput setaf 43)"
BLUE="$(tput setaf 81)"
RESET="$(tput sgr0)"
export PS1='\! [${GREEN}\u@\h${RESET} ${BLUE}\w${RESET}]$ \n> '

# Change prompt when inside a multi line command #
PS2='> '

# Enable color tmux
#alias tmux='tmux && TERM=xterm-256color'
force_color_prompt=yes

### }}}
